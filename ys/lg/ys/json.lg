;; Canonical ys.json namespace for the lg engine. jsoncompat installs
;; YAMLScript-compatible load/dump functions into let-go's json namespace.

(ns ys.json
  (:require
   [jsoncompat]
   [json]))

(def load json/load)
(def dump json/dump)

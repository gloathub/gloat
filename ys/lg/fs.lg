;; Filesystem namespace for the lg engine: the ys fs/ surface (see
;; ys/src/ys/fs.clj) backed by lg's core io fns and os namespace.

(ns fs
  (:require [clojure.string :as str]))

(defn exists? [path] (file-exists? path))
(defn e [path] (exists? path))

(defn dir? [path]
  (and (exists? path) (boolean (:dir? (os/stat path)))))
(defn d [path] (dir? path))

(defn file? [path]
  (and (exists? path) (not (:dir? (os/stat path)))))
(defn f [path] (file? path))

(defn empty-file? [path]
  (and (exists? path) (zero? (:size (os/stat path)))))
(defn z [path] (empty-file? path))

(defn size? [path]
  (when (exists? path)
    (let [n (:size (os/stat path))]
      (when (pos? n) n))))
(defn s [path] (size? path))

(defn abs? [path] (str/starts-with? path "/"))

(defn cwd [] (os/cwd))

(defn abs [path]
  (if (abs? path) path (str (cwd) "/" path)))

(defn dirname [path]
  (let [i (str/last-index-of path "/")]
    (cond
      (nil? i) "."
      (zero? i) "/"
      :else (subs path 0 i))))

(defn basename [path]
  (let [i (str/last-index-of path "/")]
    (if i (subs path (inc i)) path)))

(defn filename [path] (basename path))

(defn ls [path] (os/ls path))

(defn read [path] (slurp path))
(defn write [path content] (spit path content))

(defn touch [path]
  (os/sh "touch" path)
  path)

(defn mkdir [path] (clojure.core/mkdir path))
(defn mkdir-p [path] (clojure.core/mkdir path))

(defn rm [path] (delete-file path))
(defn rm-f [path]
  (try (delete-file path) (catch e nil)))

(defn rm-r [path]
  (when (exists? path)
    (when (dir? path)
      (doseq [name (os/ls path)]
        (rm-r (str path "/" name))))
    (delete-file path))
  nil)

;; Modification time as epoch milliseconds (like ys fs/mtime).
;; lg's os/stat reports a time string; date(1) parses it after the
;; zone-name suffix is dropped.
(defn mtime [path]
  (let [t (:mod-time (os/stat path))
        t (str/replace t #"\s+[A-Z]+$" "")
        r (os/sh "date" "-d" t "+%s%3N")]
    (parse-long (str/replace (:out r) #"\n$" ""))))

(defn mv [src dst]
  (let [r (os/sh "mv" src dst)]
    (when (not= 0 (:exit r))
      (throw (ex-info (str "fs/mv failed: " (:err r)) {})))
    nil))

(defn which [name]
  (let [r (os/sh "which" name)]
    (when (zero? (:exit r))
      (str/replace (:out r) #"\n$" ""))))
